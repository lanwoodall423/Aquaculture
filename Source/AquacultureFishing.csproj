<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>AquacultureFishing</RootNamespace>
    <AssemblyName>AquacultureFishing</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AquacultureDeveloperTests Condition="'$(AquacultureDeveloperTests)' == ''">false</AquacultureDeveloperTests>
  </PropertyGroup>
  <!--
    These paths are intentionally configurable. They may come from the command
    line or environment; the sibling Insight Canvas checkout is only a local
    development convenience and is never copied into the player package.
  -->
  <PropertyGroup>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == '' and Exists('$(RimWorldDir)/RimWorldWin64_Data/Managed/Assembly-CSharp.dll')">$(RimWorldDir)/RimWorldWin64_Data/Managed</RimWorldManagedDir>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == '' and Exists('$(RimWorldDir)/RimWorldLinux_Data/Managed/Assembly-CSharp.dll')">$(RimWorldDir)/RimWorldLinux_Data/Managed</RimWorldManagedDir>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == '' and Exists('$(RimWorldDir)/RimWorldMac.app/Contents/Resources/Data/Managed/Assembly-CSharp.dll')">$(RimWorldDir)/RimWorldMac.app/Contents/Resources/Data/Managed</RimWorldManagedDir>
    <InsightCanvasDir Condition="'$(InsightCanvasDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\InsightCanvas\1.6\Assemblies\InsightCanvas.dll')">$(MSBuildThisFileDirectory)..\..\InsightCanvas</InsightCanvasDir>
    <InsightCanvasAssemblyPath Condition="'$(InsightCanvasAssemblyPath)' == '' and '$(InsightCanvasDir)' != ''">$(InsightCanvasDir)/1.6/Assemblies/InsightCanvas.dll</InsightCanvasAssemblyPath>
    <RimBridgeServerDir Condition="'$(RimBridgeServerDir)' == ''">$(MSBuildThisFileDirectory)..\..\RimBridgeServer</RimBridgeServerDir>
    <RimBridgeSdkAssemblyPath Condition="'$(RimBridgeSdkAssemblyPath)' == '' and Exists('$(RimBridgeServerDir)/1.6/Assemblies/RimBridgeServer.Sdk.dll')">$(RimBridgeServerDir)/1.6/Assemblies/RimBridgeServer.Sdk.dll</RimBridgeSdkAssemblyPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AquacultureDeveloperTests)' == 'true'"><DefineConstants>$(DefineConstants);AQUACULTURE_DEV_TESTS</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'"><Optimize>true</Optimize><OutputPath>..\1.6\Assemblies\</OutputPath><DebugType>none</DebugType></PropertyGroup>
  <ItemGroup>
    <!-- Keep isolated DevBridge2 builds from globbing stale local intermediates. -->
    <Compile Remove="obj\**" />
    <Compile Remove="bin\**" />
    <EmbeddedResource Remove="obj\**" />
    <EmbeddedResource Remove="bin\**" />
    <None Remove="obj\**" />
    <None Remove="bin\**" />
    <Compile Remove="DeferredRealityProvider\**" />
    <Compile Remove="..\DevTools\RimBridgeTools\**\*.cs" />
    <EmbeddedResource Remove="DeferredRealityProvider\**" />
    <None Remove="DeferredRealityProvider\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(RimWorldManagedDir)' != ''">
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RimWorldManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(RimWorldManagedDir)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(RimWorldManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(HarmonyPath)' != '' and Exists('$(HarmonyPath)')">
    <Reference Include="0Harmony"><HintPath>$(HarmonyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(InsightCanvasAssemblyPath)' != '' and Exists('$(InsightCanvasAssemblyPath)')">
    <Reference Include="InsightCanvas"><HintPath>$(InsightCanvasAssemblyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(KnowledgeFrameworkAssemblyPath)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\KnowledgeFramework\1.6\Assemblies\KnowledgeFramework.dll')">
    <Reference Include="KnowledgeFramework"><HintPath>$(MSBuildThisFileDirectory)..\..\KnowledgeFramework\1.6\Assemblies\KnowledgeFramework.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(KnowledgeFrameworkAssemblyPath)' != '' and Exists('$(KnowledgeFrameworkAssemblyPath)')">
    <Reference Include="KnowledgeFramework"><HintPath>$(KnowledgeFrameworkAssemblyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateAquacultureReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldDir)' == '' and '$(RimWorldManagedDir)' == ''" Text="AquacultureFishing requires RimWorldDir or RimWorldManagedDir. Set /p:RimWorldDir=&lt;path&gt; to the RimWorld installation directory." />
    <Error Condition="'$(RimWorldManagedDir)' == ''" Text="AquacultureFishing could not find RimWorld managed assemblies. Set RimWorldDir to the 1.6 installation directory." />
    <Error Condition="'$(HarmonyPath)' == '' or !Exists('$(HarmonyPath)')" Text="AquacultureFishing requires HarmonyPath pointing to 0Harmony.dll." />
    <Error Condition="'$(InsightCanvasAssemblyPath)' == '' or !Exists('$(InsightCanvasAssemblyPath)')" Text="AquacultureFishing requires the installed InsightCanvas.dll. Set InsightCanvasDir or InsightCanvasAssemblyPath." />
    <Error Condition="'$(KnowledgeFrameworkAssemblyPath)' == '' and !Exists('$(MSBuildThisFileDirectory)..\..\KnowledgeFramework\1.6\Assemblies\KnowledgeFramework.dll')" Text="AquacultureFishing requires KnowledgeFrameworkAssemblyPath or the sibling KnowledgeFramework checkout." />
  </Target>
  <Target Name="BuildBridgeTools" AfterTargets="Build" Condition="'$(AquacultureDeveloperTests)' == 'true'">
    <Error Condition="'$(RimBridgeSdkAssemblyPath)' == '' or !Exists('$(RimBridgeSdkAssemblyPath)')" Text="Aquaculture developer tests require RimBridgeServer.Sdk.dll. Set RimBridgeSdkAssemblyPath or RimBridgeServerDir to the installed RimBridgeServer checkout." />
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\DevTools\RimBridgeTools\AquacultureFishing.BridgeTools.csproj"
      Targets="Restore;Build"
      RemoveProperties="OutputPath;OutDir"
      Properties="Configuration=$(Configuration);AquacultureFishingAssemblyPath=$(TargetPath);RimBridgeSdkAssemblyPath=$(RimBridgeSdkAssemblyPath)" />
  </Target>
  <Target Name="CopyBridgeTools" AfterTargets="BuildBridgeTools" Condition="'$(RIMWORLD_MOD_DIR)' != ''">
    <PropertyGroup>
      <GlobalBridgeToolsDir>$(RIMWORLD_MOD_DIR)\..\BridgeTools</GlobalBridgeToolsDir>
    </PropertyGroup>
    <ItemGroup>
      <AquacultureBridgeTool Include="$(MSBuildThisFileDirectory)..\artifacts\BridgeTools\AquacultureFishing\AquacultureFishing.BridgeTools.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(AquacultureBridgeTool)" DestinationFolder="$(GlobalBridgeToolsDir)\AquacultureFishing" SkipUnchangedFiles="true" />
  </Target>
</Project>
