<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AquacultureFishing</RootNamespace>
    <AssemblyName>AquacultureFishing</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AquacultureDeveloperTests Condition="'$(AquacultureDeveloperTests)' == ''">false</AquacultureDeveloperTests>
    <!-- Developer-only opt-in: standard player build still requires Knowledge Framework. -->
    <AquacultureNativeKnowledge Condition="'$(AquacultureNativeKnowledge)' == ''">false</AquacultureNativeKnowledge>
  </PropertyGroup>
  <!--
    These paths are intentionally configurable. They may come from the command
    line or environment; the sibling Insight Canvas checkout is only a local
    development convenience and is never copied into the player package.
  -->
  <PropertyGroup>
    <!--
      DevBridge2 builds this project from the installed mod tree without
      forwarding machine-specific MSBuild properties. Keep explicit
      overrides authoritative, but make the standard Steam layout usable by
      that owning workflow as well.
    -->
    <!-- 1.7 Waylith ships the three game references in the install root. -->
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and '$(RIMWORLD_ROOT)' != '' and Exists('$(RIMWORLD_ROOT)/Waylith.dll')">$(RIMWORLD_ROOT)</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\Waylith.dll')">$(MSBuildThisFileDirectory)..\..\..</RimWorldDir>
    <RimWorldAssemblyDir Condition="'$(RimWorldAssemblyDir)' == '' and Exists('$(RimWorldDir)/Waylith.dll')">$(RimWorldDir)</RimWorldAssemblyDir>
    <!-- An explicit HarmonyPath remains authoritative. Auto-discovery is 1.7-only. -->
    <HarmonyPath Condition="'$(HarmonyPath)' == '' and '$(DEFERRED_REALITY_HARMONY_PATH)' != '' and Exists('$(DEFERRED_REALITY_HARMONY_PATH)')">$(DEFERRED_REALITY_HARMONY_PATH)</HarmonyPath>
    <HarmonyPath Condition="'$(HarmonyPath)' == '' and Exists('$(RimWorldDir)/../../workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll')">$(RimWorldDir)/../../workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll</HarmonyPath>
    <HarmonyPath Condition="'$(HarmonyPath)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\Harmony\1.7\Assemblies\0Harmony.dll')">$(MSBuildThisFileDirectory)..\..\Harmony\1.7\Assemblies\0Harmony.dll</HarmonyPath>
    <InsightCanvasDir Condition="'$(InsightCanvasDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\InsightCanvas\1.7\Assemblies\InsightCanvas.dll')">$(MSBuildThisFileDirectory)..\..\InsightCanvas</InsightCanvasDir>
    <InsightCanvasAssemblyPath Condition="'$(InsightCanvasAssemblyPath)' == '' and '$(InsightCanvasDir)' != ''">$(InsightCanvasDir)/1.7/Assemblies/InsightCanvas.dll</InsightCanvasAssemblyPath>
    <RimBridgeServerDir Condition="'$(RimBridgeServerDir)' == ''">$(MSBuildThisFileDirectory)..\..\RimBridgeServer</RimBridgeServerDir>
    <RimBridgeSdkAssemblyPath Condition="'$(RimBridgeSdkAssemblyPath)' == '' and Exists('$(RimBridgeServerDir)/1.7/Assemblies/RimBridgeServer.Sdk.dll')">$(RimBridgeServerDir)/1.7/Assemblies/RimBridgeServer.Sdk.dll</RimBridgeSdkAssemblyPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AquacultureDeveloperTests)' == 'true'"><DefineConstants>$(DefineConstants);AQUACULTURE_DEV_TESTS</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'"><Optimize>true</Optimize><OutputPath>..\1.7\Assemblies\</OutputPath><DebugType>none</DebugType></PropertyGroup>
  <!-- Prevent an unqualified experimental DLL from replacing a player assembly. -->
  <PropertyGroup Condition="'$(AquacultureNativeKnowledge)' == 'true'">
    <DefineConstants>$(DefineConstants);AQUACULTURE_NATIVE_KNOWLEDGE</DefineConstants>
    <OutputPath>..\artifacts\NativeKnowledge\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep isolated DevBridge2 builds from globbing stale local intermediates. -->
    <Compile Remove="obj\**" />
    <Compile Remove="bin\**" />
    <EmbeddedResource Remove="obj\**" />
    <EmbeddedResource Remove="bin\**" />
    <None Remove="obj\**" />
    <None Remove="bin\**" />
    <Compile Remove="DeferredRealityProvider\**" />
    <Compile Remove="..\DevTools\RimBridgeTools\**\*.cs" />
    <EmbeddedResource Remove="DeferredRealityProvider\**" />
    <None Remove="DeferredRealityProvider\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(AquacultureNativeKnowledge)' == 'true'">
    <Compile Remove="AquacultureKnowledgeAdapter.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(RimWorldAssemblyDir)' != ''">
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldAssemblyDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(RimWorldAssemblyDir)/Waylith.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldAssemblyDir)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(HarmonyPath)' != '' and Exists('$(HarmonyPath)')">
    <Reference Include="0Harmony"><HintPath>$(HarmonyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(InsightCanvasAssemblyPath)' != '' and Exists('$(InsightCanvasAssemblyPath)')">
    <Reference Include="InsightCanvas"><HintPath>$(InsightCanvasAssemblyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(AquacultureNativeKnowledge)' != 'true' and '$(KnowledgeFrameworkAssemblyPath)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\KnowledgeFramework\1.7\Assemblies\KnowledgeFramework.dll')">
    <Reference Include="KnowledgeFramework"><HintPath>$(MSBuildThisFileDirectory)..\..\KnowledgeFramework\1.7\Assemblies\KnowledgeFramework.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(AquacultureNativeKnowledge)' != 'true' and '$(KnowledgeFrameworkAssemblyPath)' != '' and Exists('$(KnowledgeFrameworkAssemblyPath)')">
    <Reference Include="KnowledgeFramework"><HintPath>$(KnowledgeFrameworkAssemblyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateAquacultureReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldAssemblyDir)' == '' or !Exists('$(RimWorldAssemblyDir)/Assembly-CSharp.dll') or !Exists('$(RimWorldAssemblyDir)/Waylith.dll') or !Exists('$(RimWorldAssemblyDir)/UnityStubs.dll')" Text="AquacultureFishing requires the RimWorld 1.7 Waylith root assemblies. Set RimWorldDir or RimWorldAssemblyDir to the 1.7 installation root." />
    <Error Condition="'$(HarmonyPath)' == '' or !Exists('$(HarmonyPath)')" Text="AquacultureFishing requires a 1.7-compatible Harmony 3 0Harmony.dll. Set HarmonyPath explicitly if the 1.7 mod location is nonstandard." />
    <Error Condition="'$(InsightCanvasAssemblyPath)' == '' or !Exists('$(InsightCanvasAssemblyPath)')" Text="AquacultureFishing requires the 1.7 InsightCanvas.dll. Set InsightCanvasDir or InsightCanvasAssemblyPath to a verified 1.7 build." />
    <Error Condition="'$(AquacultureNativeKnowledge)' != 'true' and '$(KnowledgeFrameworkAssemblyPath)' == '' and !Exists('$(MSBuildThisFileDirectory)..\..\KnowledgeFramework\1.7\Assemblies\KnowledgeFramework.dll')" Text="AquacultureFishing requires KnowledgeFramework 1.7 via KnowledgeFrameworkAssemblyPath or the sibling 1.7 build." />
    <Error Condition="'$(AquacultureNativeKnowledge)' != 'true' and '$(KnowledgeFrameworkAssemblyPath)' != '' and !Exists('$(KnowledgeFrameworkAssemblyPath)')" Text="The explicit KnowledgeFrameworkAssemblyPath must identify a verified 1.7 DLL." />
  </Target>
  <Target Name="BuildBridgeTools" AfterTargets="Build" Condition="'$(AquacultureDeveloperTests)' == 'true'">
    <Error Condition="'$(RimBridgeSdkAssemblyPath)' == '' or !Exists('$(RimBridgeSdkAssemblyPath)')" Text="Aquaculture developer tests require RimBridgeServer.Sdk.dll. Set RimBridgeSdkAssemblyPath or RimBridgeServerDir to the installed RimBridgeServer checkout." />
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\DevTools\RimBridgeTools\AquacultureFishing.BridgeTools.csproj"
      Targets="Restore;Build"
      RemoveProperties="OutputPath;OutDir"
      Properties="Configuration=$(Configuration);AquacultureFishingAssemblyPath=$(TargetPath);RimBridgeSdkAssemblyPath=$(RimBridgeSdkAssemblyPath)" />
  </Target>
  <Target Name="CopyBridgeTools" AfterTargets="BuildBridgeTools" Condition="'$(RIMWORLD_MOD_DIR)' != ''">
    <PropertyGroup>
      <GlobalBridgeToolsDir>$(RIMWORLD_MOD_DIR)\..\BridgeTools</GlobalBridgeToolsDir>
    </PropertyGroup>
    <ItemGroup>
      <AquacultureBridgeTool Include="$(MSBuildThisFileDirectory)..\artifacts\BridgeTools\AquacultureFishing\AquacultureFishing.BridgeTools.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(AquacultureBridgeTool)" DestinationFolder="$(GlobalBridgeToolsDir)\AquacultureFishing" SkipUnchangedFiles="true" />
  </Target>
</Project>
